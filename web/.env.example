PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=otoshimono
PGUSER=otoshimono
PGPASSWORD=otoshimono_dev
# 実行委員の共通パスコードと、ログインの Cookie に署名する鍵（どちらもローカル開発用の値）
STAFF_PASSCODE=otoshimono-dev-passcode
SESSION_SECRET=local-dev-session-secret-change-me
# メールの送信先（開発用のテスト値。Mailpit が受け取るだけで、外には送らない）。
# 届いたメールは http://127.0.0.1:8025 で見られる（docker compose up --wait db mailpit）
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="技大祭 落とし物窓口（TEST） <test@example.com>"
# 件名の先頭に付ける。本番では空にする
MAIL_SUBJECT_PREFIX=[TEST]
# メールに載せるリンクの頭の部分
APP_ORIGIN=http://localhost:3000
